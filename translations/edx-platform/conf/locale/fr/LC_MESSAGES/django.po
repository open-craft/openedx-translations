#: lms/templates/instructor/instructor_dashboard_2/data_download.html:127
msgid ""
"{strong_start}Note{strong_end}: {ul_start}{li_start}To keep student data secure, you cannot save or email these "
"links for direct access. Copies of links expire within 5 minutes.{li_end}{li_start}Report files are deleted 90 "
