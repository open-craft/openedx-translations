#: public/js/drag_and_drop.js:360 public/js/drag_and_drop.js:595
msgid "Keyboard Help"
msgstr "Aide clavier"

#: public/js/drag_and_drop.js:363
msgid "This is a screen reader-friendly problem."
msgstr "Il s'agit d'un problème compatible avec les lecteurs d'écran."

#: public/js/drag_and_drop.js:364
msgid ""
"Drag and Drop problems consist of draggable items and dropzones. Users "
"should select a draggable item with their keyboard and then navigate to an "
"appropriate dropzone to drop it."
msgstr ""
"Les problèmes de glisser-déposer se composent d'éléments pouvant être "
"glissés et de zones de dépôt. Les utilisateurs doivent sélectionner un "
"élément à glisser à l'aide de leur clavier, puis naviguer jusqu'à une zone "
"de dépôt appropriée pour le déposer."

#: public/js/drag_and_drop.js:365
msgid ""
"You can complete this problem using only your keyboard by following the "
"guidance below:"
msgstr ""
"Vous pouvez résoudre ce problème en utilisant uniquement votre clavier en "
"suivant les instructions ci-dessous :"

#: public/js/drag_and_drop.js:367
msgid ""
"Use only TAB and SHIFT+TAB to navigate between draggable items and drop "
"zones."
msgstr ""
"Utilisez uniquement les touches TAB et SHIFT+TAB pour naviguer entre les "
"éléments pouvant être déplacés et les zones de dépôt."

#: public/js/drag_and_drop.js:368
msgid "Press CTRL+M to select a draggable item (effectively picking it up)."
msgstr ""
"Appuyez sur CTRL+M pour sélectionner un élément pouvant être déplacé (ce qui"
" revient à le ramasser)."

#: public/js/drag_and_drop.js:369
msgid ""
"Navigate using TAB and SHIFT+TAB to the appropriate dropzone and press "
"CTRL+M once more to drop it here."
msgstr ""
"Naviguez à l'aide des touches TAB et SHIFT+TAB jusqu'à la zone de dépôt "
"appropriée et appuyez à nouveau sur CTRL+M pour la déposer ici."

#: public/js/drag_and_drop.js:370
msgid ""
"Press ESC if you want to cancel the drop operation (for example, to select a"
" different item)."
msgstr ""
"Appuyez sur ESC si vous souhaitez annuler l'opération de dépôt (par exemple,"
" pour sélectionner un autre élément)."

#: public/js/drag_and_drop.js:371
msgid ""
"TAB back to the list of draggable items and repeat this process until all of"
" the draggable items have been placed on their respective dropzones."
msgstr ""
"Retournez à la liste des éléments à faire glisser et répétez ce processus "
"jusqu'à ce que tous les éléments à faire glisser aient été placés dans leurs"
" zones de dépôt respectives."

#: public/js/drag_and_drop.js:389
msgid "You have used {used} of {total} attempts."
msgstr "Vous avez utilisé {used} de {total} tentatives."

#: public/js/drag_and_drop.js:412
msgid "Submit"
msgstr "Soumettre"

#: public/js/drag_and_drop.js:453
msgid "Show Answer"
msgstr "Afficher la réponse"

#: public/js/drag_and_drop.js:462
msgid "Actions"
msgstr "Actions"

#: public/js/drag_and_drop.js:466
msgid "Go to Beginning"
msgstr "Aller au début"

#: public/js/drag_and_drop.js:472
msgid "Reset"
msgstr "Remise à zéro"

#: public/js/drag_and_drop.js:506 public/js/drag_and_drop.js:1233
msgid "Some of your answers were not correct."
msgstr "Certaines de vos réponses n'étaient pas correctes."

#: public/js/drag_and_drop.js:507 public/js/drag_and_drop.js:1236
msgid "Hints:"
msgstr "Conseils :"

#: public/js/drag_and_drop.js:577
msgid "Correct"
msgstr "Correct"

#: public/js/drag_and_drop.js:577
msgid "Incorrect"
msgstr "Incorrect"

#. Translators: {earned} is the number of points earned. {possible} is the
#. total number of points (examples: 0/1, 1/1, 2/3, 5/10). The total number of
#. points will always be at least 1. We pluralize based on the total number of
#. points (example: 0/1 point; 1/2 points).
#: public/js/drag_and_drop.js:610
msgid "{earned}/{possible} point (graded)"
msgid_plural "{earned}/{possible} points (graded)"
msgstr[0] "{earned}/{possible} point (noté)"
msgstr[1] "{earned}/{possible} points (notés)"
msgstr[2] "{earned}/{possible} points (notés)"

